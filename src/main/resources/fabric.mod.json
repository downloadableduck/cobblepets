{
  "schemaVersion": 1,
  "id": "petsmod-nyan-cat",
  "version": "${version}",
  "name": "Nyan Cat for PetsMod",
  "description": "Adds nyan cat support for PetsMod",
  "authors": [
    "downloadableduck"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/petsmod-nyan-cat/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.jeff.pets.nyancat.PetsmodNyanCat"
    ],
    "client": [
      "com.jeff.pets.nyancat.client.NyanCatClient"
    ]
  },
  "mixins": [
    "nyan-cat.mixins.json",
    {
      "config": "nyan-cat-client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.2",
    "minecraft": ">=26.1",
    "java": ">=25",
    "fabric-api": "*",
    "pets-mod": ">=0.8.0-26.1.1-alpha"
  }
}